{
  "configById": {
    "3D!ttb3nav": {
      "cameraState": {
        "perspective": false,
        "distance": 10,
        "phi": 0,
        "thetaOffset": 0,
        "targetOffset": [0, 0, 0],
        "target": [0, 0, 0],
        "targetOrientation": [0, 0, 0, 1],
        "fovy": 45,
        "near": 0.01,
        "far": 5000
      },
      "followTf": "map",
      "scene": {
        "enableStats": false,
        "meshUpAxis": "z_up",
        "labelScale": 0.5,
        "backgroundColor": "#15171c"
      },
      "transforms": {
        "frame:wheel_left_link": { "visible": false },
        "frame:wheel_right_link": { "visible": false },
        "frame:caster_back_link": { "visible": false },
        "frame:base_scan": { "visible": false },
        "frame:imu_link": { "visible": false }
      },
      "topics": {
        "/map": {
          "visible": true,
          "colorMode": "custom",
          "minColor": "#f2f4f8ff",
          "maxColor": "#0f1216ff",
          "unknownColor": "#00000000",
          "invalidColor": "#00000000",
          "frameLocked": true
        },
        "/global_costmap/costmap": {
          "visible": false,
          "colorMode": "costmap",
          "alpha": 0.3
        },
        "/local_costmap/costmap": {
          "visible": true,
          "colorMode": "costmap",
          "alpha": 0.45
        },
        "/scan": {
          "visible": true,
          "pointSize": 3,
          "colorMode": "flat",
          "flatColor": "#00e5ffff"
        },
        "/plan": { "visible": true, "color": "#39ff88ff", "lineWidth": 0.04 },
        "/particle_cloud": { "visible": true, "color": "#ffb02eaa" },
        "/tf": { "visible": true }
      },
      "layers": {},
      "publish": {
        "type": "pose_estimate",
        "poseTopic": "/goal_pose",
        "pointTopic": "/clicked_point",
        "poseEstimateTopic": "/initialpose"
      },
      "imageMode": {}
    },
    "RawMessages!amclpose": {
      "topicPath": "/amcl_pose",
      "diffEnabled": false,
      "expansion": "all"
    },
    "CallService!savezonerobot": {
      "serviceName": "/save_zone",
      "requestPayload": "{\n  \"source\": \"robot\",\n  \"yaw\": 0.0\n}",
      "buttonText": "Save mission point (robot here)",
      "buttonTooltip": "Appends where the robot is standing right now, heading included, to maps/mission_zones.yaml.",
      "buttonColor": "#7b61ff",
      "layout": "vertical",
      "editingMode": false
    },
    "Teleop!drive": {
      "topic": "/cmd_vel",
      "publishRate": 5,
      "upButton": { "field": "linear-x", "value": 0.2 },
      "downButton": { "field": "linear-x", "value": -0.2 },
      "leftButton": { "field": "angular-z", "value": 1.0 },
      "rightButton": { "field": "angular-z", "value": -1.0 }
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": { "speed": 1 },
  "layout": {
    "first": "3D!ttb3nav",
    "second": {
      "first": "RawMessages!amclpose",
      "second": {
        "first": "CallService!savezonerobot",
        "second": "Teleop!drive",
        "direction": "column"
      },
      "direction": "column",
      "splitPercentage": 45
    },
    "direction": "row",
    "splitPercentage": 72
  }
}
