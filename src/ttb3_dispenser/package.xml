<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ttb3_dispenser</name>
  <version>0.1.0</version>
  <description>Supply-box dispenser controller with a swappable hardware backend for the RobotKub TurtleBot3 WRG2026 mission</description>
  <maintainer email="napat559977@gmail.com">robotkub</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>ttb3_msgs</depend>
  <!-- Servo control on Pi GPIO. Only needed when use_mock_hardware:=false;
       lazy-imported in gpio_backend.py so the mock path has no hard dep. -->
  <exec_depend>python3-gpiozero</exec_depend>
  <exec_depend>python3-lgpio</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
