# Copy to .env:  cp .env.example .env
#
# Normally you don't need to change ANYTHING here. The Pi's IP is DHCP and
# keeps moving (several saved APs, plus the competition venue is a different
# network entirely), so ./ttb3 finds the robot by NAME instead: the Pi runs
# avahi, so `skuba.local` follows it onto whichever network it joins. No
# static IP to break when the network changes.
ROBOT_HOST=skuba.local

# Only needed if mDNS is blocked on your network (some guest/venue WiFi
# isolates clients). Uncomment and set the real address, and it wins over
# ROBOT_HOST above -- find it with `hostname -I` on the robot.
#ROBOT_IP=192.168.1.127

# Must match the Pi's ~/.bashrc. Change it to something unique for your team
# before competition day -- 6-7 teams share one WiFi AP per arena, and the
# same ID means you see (and interfere with) each other's robots.
ROS_DOMAIN_ID=42
