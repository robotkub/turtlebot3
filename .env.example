# Copy to .env and set ROBOT_IP to your Pi's current address:
#   cp .env.example .env
#
# docker compose reads .env automatically, so you set this ONCE instead of
# prefixing every command. The ./ttb3 wrapper reads it too.
#
# The Pi's IP is DHCP and moves around -- find it with `hostname -I` on the
# robot, or check your router's client list.
ROBOT_IP=192.168.1.127

# Must match the Pi's ~/.bashrc. Change it to something unique for your team
# before competition day -- 6-7 teams share one WiFi AP per arena, and the
# same ID means you see (and interfere with) each other's robots.
ROS_DOMAIN_ID=42
