// Zenoh session config for the laptop-side ttb3-compute container.
//
// Why this file exists: Docker Desktop (Mac/Windows) does not bridge
// containers onto the real LAN even with `network_mode: host` -- it's a
// VM underneath. UDP multicast (what cyclonedds/zenoh use by default to
// *discover* peers) never reaches the robot over WiFi. Zenoh sessions can
// instead connect directly to a known router over plain unicast TCP, which
// Docker Desktop's networking handles fine -- so we skip discovery
// entirely and hard-connect to the router running on the robot.
//
// ${ROBOT_IP} is substituted at container start (see docker/ros_entrypoint.sh)
// from the ROBOT_IP environment variable -- set it to the Pi's current IP,
// e.g. `ROBOT_IP=192.168.1.127 docker compose run ...`.
{
  mode: "client",
  connect: {
    endpoints: ["tcp/${ROBOT_IP}:7447"],
  },
  scouting: {
    multicast: {
      enabled: false,
    },
  },

  // Zenoh's default is 10000ms, and rmw_zenoh uses this timeout for ROS
  // SERVICE calls. Nav2 bringup blows straight through it:
  //
  //   lifecycle_manager_navigation calls controller_server/change_state
  //     -> controller_server activates local_costmap
  //     -> local_costmap blocks waiting for odom -> base_link
  //
  // That wait was measured at 36.0s on this setup (tf_static, which carries
  // base_footprint -> base_link, is TRANSIENT_LOCAL and reaches a late-joining
  // container slowly, so TF sits as "two or more unconnected trees" until it
  // lands). The activation itself SUCCEEDS -- but at 10s the lifecycle manager
  // has already given up on the reply, and when it finally arrives zenoh logs
  // "Received ReplyData for unknown Query". The manager then never advances to
  // smoother_server/planner_server/bt_navigator, and never prints "Managed
  // nodes are active".
  //
  // Nothing reports an error. Nav2 just sits there permanently half-activated,
  // bt_navigator inactive, silently unable to accept a single goal.
  //
  // 60s is chosen to clear that 36s worst case with headroom. The cost is that
  // a service call to a genuinely dead node blocks 60s instead of 10s before
  // failing -- much cheaper than a stack that stalls forever without saying so.
  queries_default_timeout: 60000,
}
