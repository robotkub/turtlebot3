[Unit]
Description=TurtleBot3 hardware bringup (OpenCR base, lidar, camera, dispenser)
 -- the robot half only; Nav2/perception/mission run on the compute laptop
 via `./ttb3 mission`
After=network-online.target zenoh-router.service
Wants=network-online.target
# The router carries the ROS graph to the laptop. Starting before it works
# (zenoh reconnects) but the first seconds of topics would go nowhere, so
# order behind it.
After=zenoh-router.service
# The dispenser servo needs pigpiod for steady (non-jittery) PWM -- starting
# before it works too (gpiozero's PiGPIOFactory just fails to connect and
# the unit restarts, per StartLimitIntervalSec below), but ordering behind
# it avoids that restart churn on every boot.
After=pigpiod.service
# The USB serial devices (OpenCR on ttyACM0, lidar on ttyUSB0) can take a
# moment to enumerate after a cold boot; without this the unit burns through
# systemd's default budget (5 starts / 10s) before the hardware is even there
# and parks in `failed`. These two keys are [Unit] keys -- systemd ignores
# them with an "Unknown key name" warning if they sit under [Service].
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=__USER__
# Set the environment HERE rather than leaning on ~/.bashrc.
#
# `bash -lc` looks like it should be enough -- it is a *login* shell -- but it
# is not interactive, and Ubuntu's stock ~/.bashrc starts with
#     case $- in *i*) ;; *) return;; esac
# so it returns immediately for non-interactive shells and sets nothing. The
# service crash-looped on `[ERROR] [launch]: Caught exception in launch:
# 'TURTLEBOT3_MODEL'` until these were declared explicitly.
#
# ROS_DOMAIN_ID must match the value in ~/.bashrc and on the laptop (.env).
# If you change one, change all three.
Environment=TURTLEBOT3_MODEL=burger
Environment=LDS_MODEL=LDS-01
Environment=ROS_DOMAIN_ID=42
Environment=RMW_IMPLEMENTATION=rmw_zenoh_cpp
# systemd runs a unit from / by default, which this user cannot write to.
# Harmless for pigpio (unlike the lgpio pin factory this used to be, which
# wrote notification files named .lgd-nfy* to the current directory and
# died with FileNotFoundError there), but ROS itself still wants a writable
# CWD for log files, so this stays set regardless of GPIO backend.
WorkingDirectory=__WS__
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash && source __WS__/install/setup.bash && exec ros2 launch ttb3_bringup hardware.launch.py __ARGS__'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
