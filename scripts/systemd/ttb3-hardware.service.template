[Unit]
Description=TurtleBot3 hardware bringup (OpenCR base, lidar, camera, dispenser)
 -- the robot half only; Nav2/perception/mission run on the compute laptop
 via `./ttb3 mission`
After=network-online.target zenoh-router.service
Wants=network-online.target
# The router carries the ROS graph to the laptop. Starting before it works
# (zenoh reconnects) but the first seconds of topics would go nowhere, so
# order behind it.
After=zenoh-router.service

[Service]
Type=simple
User=__USER__
# A login shell so ~/.bashrc supplies TURTLEBOT3_MODEL, LDS_MODEL,
# ROS_DOMAIN_ID and RMW_IMPLEMENTATION. systemd units get none of that
# otherwise -- a non-interactive shell skips .bashrc entirely and the launch
# dies with KeyError: 'TURTLEBOT3_MODEL'.
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source __WS__/install/setup.bash && exec ros2 launch ttb3_bringup hardware.launch.py __ARGS__'
Restart=on-failure
RestartSec=5
# The USB serial devices (OpenCR on ttyACM0, lidar on ttyUSB0) can take a
# moment to enumerate after a cold boot; without this the unit can burn
# through its restart budget before the hardware is even there.
StartLimitIntervalSec=120
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
