#!/usr/bin/env bash
#
# ttb3 -- one command for every laptop-side task.
#
#   ./ttb3 nav       navigation (Nav2 + AMCL against the saved map)
#   ./ttb3 mission   the FULL mission here instead of on the Pi -- Nav2 +
#                    perception + mission nodes. On the Pi run only
#                    `ros2 launch ttb3_bringup hardware.launch.py`.
#   ./ttb3 map       build a map (slam_toolbox SLAM, auto-saves)
#   ./ttb3 teleop    keyboard driving (run in a SECOND terminal)
#   ./ttb3 replay    replay a recorded bag through the whole stack (no robot)
#   ./ttb3 record    record a bag from the live robot
#   ./ttb3 detect    perception only -- is the camera detecting? (no Nav2)
#   ./ttb3 test_servo [n]  fire the dispenser gate n times (default 1)
#   ./ttb3 build     rebuild the Docker image (only for msgs/deps changes --
#                    launch files, params and Python are mounted, not baked)
#   ./ttb3 shell     a bash prompt inside the container
#
# Everything that used to be a wall of `ROS_DOMAIN_ID=42 ROBOT_IP=... docker
# compose run --rm --service-ports ttb3-compute ros2 launch ...` is handled
# here, including the two flags that are easy to forget and fail confusingly:
#   --service-ports  without it `docker compose run` publishes NO ports, so
#                    Foxglove sits at "Waiting for connection..." forever even
#                    though the bridge is running fine inside the container
#   ROBOT_IP         docker-compose.yml needs it just to PARSE, so even
#                    `build` fails without it -- `build` gets a placeholder
#                    here, since it never actually talks to the robot
#
# Finding the robot: nothing to configure. The Pi runs avahi, so it's resolved
# by NAME (skuba.local) on every run -- see resolve_ipv4 below. Put ROBOT_IP in
# .env, or set it per-run, only when you need to override that.
#
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

# .env is the normal way to set these (docker compose reads it natively too).
# Sourcing it would CLOBBER anything passed on the command line, though --
# `ROBOT_IP=x ./ttb3 nav` has to win over the file, the same way it does for
# docker compose -- so stash the pre-set values and put them back afterwards.
_pre_ROBOT_IP="${ROBOT_IP:-}"
_pre_ROBOT_HOST="${ROBOT_HOST:-}"
_pre_ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-}"
if [ -f .env ]; then
  set -a
  # shellcheck disable=SC1091
  . ./.env
  set +a
fi
if [ -n "$_pre_ROBOT_IP" ]; then ROBOT_IP="$_pre_ROBOT_IP"; fi
if [ -n "$_pre_ROBOT_HOST" ]; then ROBOT_HOST="$_pre_ROBOT_HOST"; fi
if [ -n "$_pre_ROS_DOMAIN_ID" ]; then ROS_DOMAIN_ID="$_pre_ROS_DOMAIN_ID"; fi

export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-42}"
ROBOT_HOST="${ROBOT_HOST:-skuba.local}"

# The Pi's IP is DHCP and moves constantly (it has several APs saved, and the
# competition venue is a different network again), so we don't hardcode one:
# the Pi runs avahi, so `skuba.local` follows it onto whatever network it
# joins. Resolve that here on the HOST rather than inside the container --
# Docker's resolver answers .local with an IPv6 address, and the zenoh
# endpoint template is a bare `tcp/${ROBOT_IP}:7447`, which needs brackets to
# be valid with IPv6. Pinning ROBOT_IP by hand still wins over all of this.
resolve_ipv4() {
  local host="$1" ip="" ping_timeout
  # 1. libc/NSS. Works out of the box on macOS, and on Linux boxes that have
  #    nss-mdns installed (most desktops do, most servers don't).
  ip="$(python3 -c "import socket,sys
try: print(socket.getaddrinfo(sys.argv[1], None, socket.AF_INET)[0][4][0])
except Exception: pass" "$host" 2>/dev/null || true)"
  # 2. Ask avahi directly -- covers exactly the Linux-without-nss-mdns gap.
  [ -n "$ip" ] || ip="$(avahi-resolve -n4 "$host" 2>/dev/null | awk 'NR==1{print $2}')"
  # 3. ping, purely to read the address back out of its first line. Its
  #    timeout flag is NOT portable: -W seconds on Linux, where -t is instead
  #    the TTL (so `-t1` silently caps the probe at one hop and fails across
  #    any router); -t seconds on macOS/BSD, where -W is milliseconds.
  if [ -z "$ip" ]; then
    case "$(uname -s)" in
      Darwin|*BSD) ping_timeout=(-t 1) ;;
      *)           ping_timeout=(-W 1) ;;
    esac
    #    The capture must anchor on the FIRST '(' -- `[^(]*` can't cross one,
    #    where a leading `.*` would. Linux ping prints the packet size in a
    #    second pair of parens ("PING skuba.local (192.168.1.127) 56(84) bytes
    #    of data."), and a greedy match silently returns 84 as the address.
    #    macOS prints only one pair, which is why that reads as fine there.
    ip="$(ping -c1 "${ping_timeout[@]}" "$host" 2>/dev/null |
          sed -n '1s/^[^(]*(\([0-9.]*\)).*/\1/p')"
  fi
  [ -n "$ip" ] && printf '%s' "$ip"
}

CMD="${1:-}"
ALL_ARGS="$*"          # stashed for the error message below, before the shift
[ $# -gt 0 ] && shift

# Which commands actually have to reach the robot? `build` doesn't: it needs
# ROBOT_IP only to be non-empty, because docker-compose.yml guards it with
# ${ROBOT_IP:?...} and an unset value fails the file's *parse*. Help needs
# nothing at all. Gating those on mDNS meant you couldn't rebuild the image --
# or even read the usage text -- with the Pi switched off, which is exactly
# when you tend to be doing both.
case "$CMD" in
  build|""|-h|--help|help) NEEDS_ROBOT=0 ;;
  *)                       NEEDS_ROBOT=1 ;;
esac

if [ -n "${ROBOT_IP:-}" ]; then
  RESOLVED_FROM="pinned "
  # A pin is meant to be a literal IPv4 address, but `ROBOT_IP=skuba.local` is
  # an easy thing to write (the docs used to invite it outright). Passing a
  # NAME straight through silently breaks: the zenoh endpoint template is an
  # unbracketed tcp/${ROBOT_IP}:7447, and .local names answer with IPv6 first,
  # which makes that endpoint unparseable. So resolve anything that isn't
  # already all-digits-and-dots. Only when we actually need the robot, though
  # -- build/help must stay usable with the Pi off (see df32505).
  if [ "$NEEDS_ROBOT" -eq 1 ]; then
    case "$ROBOT_IP" in
      *[!0-9.]*)
        _pin="$ROBOT_IP"
        ROBOT_IP="$(resolve_ipv4 "$_pin" || true)"
        if [ -z "$ROBOT_IP" ]; then
          echo "ERROR: ROBOT_IP is pinned to '${_pin}', which is not an IPv4" >&2
          echo "       address and does not resolve to one." >&2
          echo "" >&2
          echo "  Pin a literal address (ROBOT_IP=192.168.1.x), or unset it" >&2
          echo "  entirely to find the robot by name (${ROBOT_HOST}) instead." >&2
          exit 1
        fi
        RESOLVED_FROM="pinned ${_pin} -> "
        ;;
    esac
  fi
elif [ "$NEEDS_ROBOT" -eq 0 ]; then
  ROBOT_IP="0.0.0.0"   # placeholder only, to satisfy ${ROBOT_IP:?} in compose
  RESOLVED_FROM=""
else
  ROBOT_IP="$(resolve_ipv4 "$ROBOT_HOST" || true)"
  if [ -z "$ROBOT_IP" ]; then
    echo "ERROR: can't reach '${ROBOT_HOST}' -- is the Pi powered on and on" >&2
    echo "       the same network as this laptop?" >&2
    echo "" >&2
    echo "  If mDNS is blocked on this network, pin the address instead:" >&2
    echo "    ROBOT_IP=192.168.1.x ./ttb3 ${ALL_ARGS}" >&2
    echo "  or put ROBOT_IP=... in .env, next to this script." >&2
    echo "  Find it with 'hostname -I' on the robot." >&2
    exit 1
  fi
  RESOLVED_FROM="${ROBOT_HOST} -> "
fi
export ROBOT_IP
if [ "$NEEDS_ROBOT" -eq 1 ]; then
  echo "robot: ${RESOLVED_FROM}${ROBOT_IP}   ROS_DOMAIN_ID=${ROS_DOMAIN_ID}"
fi

# --service-ports publishes 8765 so Foxglove can reach foxglove_bridge.
run() { docker compose run --rm --service-ports ttb3-compute "$@"; }
# ...but NOT for teleop: it would collide with the port already published by
# the nav/map container that's supposed to be running alongside it.
run_noports() { docker compose run --rm ttb3-compute "$@"; }

case "$CMD" in
  nav)
    echo "==> navigation  (Foxglove: ws://localhost:8765)"
    run ros2 launch ttb3_bringup navigation.launch.py visualize:=true "$@"
    ;;
  mission)
    # The thinking half of the robot, running here instead of on the Pi.
    # The Pi only needs `ros2 launch ttb3_bringup hardware.launch.py`; zenoh
    # carries the graph between the two. Doing it this way is why the Pi
    # stops falling over -- Nav2 + apriltag + mission together saturate it.
    echo "==> mission     (Foxglove: ws://localhost:8765)"
    echo "    on the Pi, run:  ros2 launch ttb3_bringup hardware.launch.py"
    echo "    camera frames arrive compressed and are decoded here"
    run ros2 launch ttb3_bringup mission.launch.py visualize:=true "$@"
    ;;
  map)
    echo "==> mapping     (Foxglove: ws://localhost:8765)"
    echo "    map auto-saves to ./maps/ continuously and on Ctrl-C"
    echo "    drive it: open a second terminal and run  ./ttb3 teleop"
    run ros2 launch ttb3_bringup mapping.launch.py \
      map_path:="${MAP_NAME:-arena_v1}" visualize:=true "$@"
    ;;
  teleop)
    echo "==> keyboard teleop (this needs its own terminal -- ros2 launch"
    echo "    can't give a bundled node the real TTY it needs)"
    run_noports ros2 run turtlebot3_teleop teleop_keyboard \
      --ros-args -r cmd_vel:=cmd_vel_teleop
    ;;
  replay)
    # Replay a recorded session instead of a live robot. The Pi still has to
    # be powered on (its zenoh router is what all the ROS traffic flows
    # through) but the lidar/OpenCR do NOT need to be plugged in -- the bag
    # supplies /scan, /odom and /tf in their place.
    #
    # This is self-contained: bag playback AND Nav2/AMCL/Foxglove come up
    # together from this one command (see replay.launch.py).
    BAG="${1:-$(ls -1dt bags/*/ 2>/dev/null | head -1)}"
    [ $# -gt 0 ] && shift
    if [ -z "$BAG" ] || [ ! -d "$BAG" ]; then
      echo "ERROR: no bag found in ./bags/. Record one with:" >&2
      echo "  ./ttb3 record <name>" >&2
      exit 1
    fi
    BAG_IN_CONTAINER="/bags/$(basename "${BAG%/}")"
    echo "==> replaying ${BAG_IN_CONTAINER} through the full nav stack"
    echo "    Foxglove: ws://localhost:8765"
    run ros2 launch ttb3_bringup replay.launch.py bag:="$BAG_IN_CONTAINER" "$@"
    ;;
  record)
    NAME="${1:-bringup_$(date +%Y%m%d_%H%M%S)}"
    [ $# -gt 0 ] && shift
    echo "==> recording to ./bags/${NAME}  (Ctrl-C to stop)"
    run_noports ros2 bag record -o "/bags/${NAME}" \
      /scan /odom /tf /tf_static /imu /joint_states /robot_description \
      /battery_state /sensor_state /magnetic_field "$@"
    ;;
  detect)
    # Perception only -- no Nav2, no mission, no localisation. Answers "is the
    # camera detecting?" without the 40s bringup and the wall of unrelated log
    # that the full stack produces.
    echo "==> detect      hold a tag in front of the camera"
    echo "    the answer prints below as it changes:  TAG 3  ->  3 boxes"
    echo "    (no Nav2, no mission -- the robot cannot move)"
    echo "    add  visualize:=true  to also watch the camera in Foxglove"
    echo "    apriltag_node prints its own counters every 10s -- 'Synchronized"
    echo "    pairs: 0' means it never even looked at a frame (camera_info is"
    echo "    not arriving), which is NOT the same as looking and finding none."
    run ros2 launch ttb3_bringup detect.launch.py "$@"
    ;;
  test_servo)
    # Fires the dispenser gate. dispenser_controller lives on the Pi (it drives
    # a GPIO servo), so this just publishes the same topic the mission uses and
    # reads back the count -- no special test path that could drift from how
    # the real thing behaves.
    #
    # NOTE: the servo only physically moves when hardware.launch.py was started
    # with use_mock_hardware:=false. With the mock backend this still prints a
    # decremented count, so a "working" result here does not prove the servo
    # turned -- watch the robot.
    N="${1:-1}"
    [ $# -gt 0 ] && shift
    echo "==> dispensing ${N} box(es) via /dispense_command"
    echo "    watch the robot: the gate should swing and return"
    # `timeout` the coreutils binary, NOT `ros2 topic echo --timeout`: that
    # flag does not exist in Humble, and without it a topic that never
    # publishes hangs the command forever.
    run_noports bash -c "
      before=\$(timeout 4 ros2 topic echo /boxes_remaining --once 2>/dev/null | sed -n 's/^data: //p')
      echo \"  before: \${before:-(no /boxes_remaining yet -- dispenser_controller may be down)}\"
      ros2 topic pub -1 /dispense_command std_msgs/msg/Int32 '{data: ${N}}' >/dev/null 2>&1
      after=\$(timeout 8 ros2 topic echo /boxes_remaining --once 2>/dev/null | sed -n 's/^data: //p')
      echo \"  after:  \${after:-(no reply -- is ttb3-hardware running on the Pi?)}\"
    " "$@"
    ;;
  build)
    echo "==> rebuilding the compute image"
    docker compose build "$@"
    ;;
  shell)
    run_noports bash "$@"
    ;;
  ""|-h|--help|help)
    # The header block runs to the line before the first blank comment line
    # after it -- derived, not a hardcoded range. It used to be `3,12p`, which
    # silently stopped at `record` and never printed `build` or `shell`; adding
    # a command then made it drop more. awk keeps it correct by construction.
    # NR>4 on the exit test because line 4 is the blank comment line that
    # separates the title from the list -- stopping there would print only
    # the title.
    awk 'NR>=3 { if ($0 == "#" && NR > 4) exit; sub(/^# ?/, ""); print }' "$0"
    echo ""
    if [ -n "$RESOLVED_FROM" ]; then
      echo "Robot: ROBOT_IP pinned to ${ROBOT_IP}"
    else
      echo "Robot: found by name as ${ROBOT_HOST} (mDNS), re-resolved each run."
      echo "       Pin one with ROBOT_IP=... in .env only if mDNS is blocked."
    fi
    echo "ROS_DOMAIN_ID: ${ROS_DOMAIN_ID}"
    ;;
  *)
    echo "ttb3: unknown command '$CMD'" >&2
    echo "try: ./ttb3 help" >&2
    exit 1
    ;;
esac
